# Local secrets — never commit
.env

# Data (raw + processed + tokenized). The small committed sample under
# data/raw/sample/ is kept in git; everything large/generated stays out.
data/raw/gutenberg/
data/processed/*
data/tokenized/*
data/stats/
!data/processed/.gitkeep
!data/tokenized/.gitkeep

# Checkpoints and logs
checkpoints/*
!checkpoints/.gitkeep
logs/

# Trained tokenizer artifacts (retrain on a bigger corpus => they change).
# The tokenizer CODE is committed; the trained JSON/vocab/report are not.
tokenizer/ankit_tokenizer.json
tokenizer/vocab.json
tokenizer/tokenizer_report.json
tokenizer/_test_*

# File-system noise
*.bin
*.pt
*.ckpt

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/
build/
dist/

# Editor / OS
.DS_Store
.vscode/
.idea/
