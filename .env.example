# ═══════════════════════════════════════════════════════════════════════
# ANKIT 0.1 — environment template
#
# Copy this file to `.env` on your LOCAL machine and on the CLOUD machine:
#     cp .env.example .env
# Never commit `.env`. This example file is the only thing you commit.
# ═══════════════════════════════════════════════════════════════════════

# ── Device ─────────────────────────────────────────────────────────────
# "cuda" means "use the NVIDIA GPU we verified with verify_environment.py".
# "cpu" means "use the CPU (fine for tiny smoke tests, but slow)".
ANKIT_DEVICE=cuda

# ── Random seed for reproducible training ─────────────────────────────
ANKIT_SEED=1337

# ── Output directories (relative to the project root) ─────────────────
ANKIT_CHECKPOINT_DIR=checkpoints
ANKIT_LOG_DIR=logs

# ── Optional: cloud credentials (NOT used for from-scratch training) ──
# No API keys are required to train ANKIT 0.1 from scratch.
# If you later add an optional RAG/API service, put its keys here.
# ANKIT_API_KEY=
