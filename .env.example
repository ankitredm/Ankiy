# ── Local model (works with Ollama's OpenAI-compatible endpoint) ──────────────
# Install Ollama, run: ollama pull llama3.2, then leave these as-is.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
# LLM_API_KEY=                         # only needed by a hosted OpenAI-compatible service

# ── Personalization ──────────────────────────────────────────────────────────
OWNER_NAME=friend
DEFAULT_PROFILE=luna
# A comma-separated allow-list is strongly recommended for Telegram.
# Example: TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_ALLOWED_USER_IDS=

# ── Telegram (optional) ──────────────────────────────────────────────────────
# Create a bot with @BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=

# ── ElevenLabs voice (optional) ──────────────────────────────────────────────
# In ElevenLabs Voice Lab, copy the voice ID for your custom or chosen voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── AI selfies / images (optional, OpenAI-compatible Images API) ─────────────
# Kept separate from the chat provider, so local chat never requires a cloud key.
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1024
